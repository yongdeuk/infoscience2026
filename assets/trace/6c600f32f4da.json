{"code":["def greedy_coin_change(amount, coins):","    result = []","    for coin in coins:              # 큰 동전부터 차례로","        while amount >= coin:       # 이 동전을 줄 수 있는 동안","            amount -= coin          # 그만큼 빼고","            result.append(coin)     # 준 동전 목록에 추가","    return result","","coins = [50, 10, 5, 1]              # 큰 것부터(내림차순) 적어 둔 동전 종류","amount = 63                         # 거슬러 줄 금액","change = greedy_coin_change(amount, coins)","print('거슬러 줄 동전:', change)"],"notes":{},"steps":[{"l":1,"k":"line","s":[["전역",[]]],"o":"","n":"프로그램을 시작해요. 위에서부터 한 줄씩 실행해요."},{"l":9,"k":"line","s":[["전역",[["greedy_coin_change","함수"]]]],"o":"","n":"1번 줄 실행 → greedy_coin_change 함수를 정의했어요(아직 실행되지는 않아요)."},{"l":10,"k":"line","s":[["전역",[["greedy_coin_change","함수"],["coins","[50, 10, 5, 1]"]]]],"o":"","n":"9번 줄 실행 → coins에 [50, 10, 5, 1]이(가) 저장됐어요."},{"l":11,"k":"line","s":[["전역",[["greedy_coin_change","함수"],["coins","[50, 10, 5, 1]"],["amount","63"]]]],"o":"","n":"10번 줄 실행 → amount에 63이(가) 저장됐어요."},{"l":2,"k":"line","s":[["전역",[["greedy_coin_change","함수"],["coins","[50, 10, 5, 1]"],["amount","63"]]],["greedy_coin_change()",[["amount","63"],["coins","[50, 10, 5, 1]"]]]],"o":"","n":"11번 줄 실행 → greedy_coin_change() 함수를 불렀어요 (amount=63, coins=[50, 10, 5, 1])."},{"l":3,"k":"line","s":[["전역",[["greedy_coin_change","함수"],["coins","[50, 10, 5, 1]"],["amount","63"]]],["greedy_coin_change()",[["amount","63"],["coins","[50, 10, 5, 1]"],["result","[]"]]]],"o":"","n":"2번 줄 실행 → result에 []이(가) 저장됐어요."},{"l":4,"k":"line","s":[["전역",[["greedy_coin_change","함수"],["coins","[50, 10, 5, 1]"],["amount","63"]]],["greedy_coin_change()",[["amount","63"],["coins","[50, 10, 5, 1]"],["result","[]"],["coin","50"]]]],"o":"","n":"3번 줄 실행 → coin에 50이(가) 저장됐어요."},{"l":5,"k":"line","s":[["전역",[["greedy_coin_change","함수"],["coins","[50, 10, 5, 1]"],["amount","63"]]],["greedy_coin_change()",[["amount","63"],["coins","[50, 10, 5, 1]"],["result","[]"],["coin","50"]]]],"o":"","n":"4번 줄 실행 → 조건을 확인했어요."},{"l":