{"code":["a = {}","a['A'] = 'T'   # 아데닌과 티민","a['T'] = 'A'","a['G'] = 'C'   # 구아닌과 사이토신","a['C'] = 'G'","print(a)"],"notes":{},"steps":[{"l":1,"k":"line","s":[["전역",[]]],"o":"","n":"프로그램을 시작해요. 위에서부터 한 줄씩 실행해요."},{"l":2,"k":"line","s":[["전역",[["a","{}"]]]],"o":"","n":"1번 줄 실행 → a에 {}이(가) 저장됐어요."},{"l":3,"k":"line","s":[["전역",[["a","{'A': 'T'}"]]]],"o":"","n":"2번 줄 실행 → a: {} → {'A': 'T'}"},{"l":4,"k":"line","s":[["전역",[["a","{'A': 'T', 'T': 'A'}"]]]],"o":"","n":"3번 줄 실행 → a: {'A': 'T'} → {'A': 'T', 'T': 'A'}"},{"l":5,"k":"line","s":[["전역",[["a","{'A': 'T', 'T': 'A', 'G': 'C'}"]]]],"o":"","n":"4번 줄 실행 → a: {'A': 'T', 'T': 'A'} → {'A': 'T', 'T': 'A', 'G': 'C'}"},{"l":6,"k":"line","s":[["전역",[["a","{'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G'}"]]]],"o":"","n":"5번 줄 실행 → a: {'A': 'T', 'T': 'A', 'G': 'C'} → {'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G'}"},{"l":0,"k":"end","s":[["전역",[["a","{'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G'}"]]]],"o":"{'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G'}\n","n":"6번 줄 실행 → 화면에 출력: {'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G'} 프로그램이 끝났어요."}]}