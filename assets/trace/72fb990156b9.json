{"code":["def linear_search(arr, target):","    for i in range(len(arr)):        # 0번 칸부터 마지막 칸까지 차례로","        if arr[i] == target:         # 찾는 값과 같으면","            return i                 # 그 위치(인덱스)를 돌려주고 끝","    return -1                        # 끝까지 없으면 -1","","arr = [9, 5, 8, 3, 7]","target = 8","result = linear_search(arr, target)","print(f'Target found at index: {result}')"],"notes":{},"steps":[{"l":1,"k":"line","s":[["전역",[]]],"o":"","n":"프로그램을 시작해요. 위에서부터 한 줄씩 실행해요."},{"l":7,"k":"line","s":[["전역",[["linear_search","함수"]]]],"o":"","n":"1번 줄 실행 → linear_search 함수를 정의했어요(아직 실행되지는 않아요)."},{"l":8,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"]]]],"o":"","n":"7번 줄 실행 → arr에 [9, 5, 8, 3, 7]이(가) 저장됐어요."},{"l":9,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]]],"o":"","n":"8번 줄 실행 → target에 8이(가) 저장됐어요."},{"l":2,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]],["linear_search()",[["arr","[9, 5, 8, 3, 7]"],["target","8"]]]],"o":"","n":"9번 줄 실행 → linear_search() 함수를 불렀어요 (arr=[9, 5, 8, 3, 7], target=8)."},{"l":3,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]],["linear_search()",[["arr","[9, 5, 8, 3, 7]"],["target","8"],["i","0"]]]],"o":"","n":"2번 줄 실행 → i에 0이(가) 저장됐어요."},{"l":2,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]],["linear_search()",[["arr","[9, 5, 8, 3, 7]"],["target","8"],["i","0"]]]],"o":"","n":"3번 줄 실행 → 조건을 확인했어요."},{"l":3,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]],["linear_search()",[["arr","[9, 5, 8, 3, 7]"],["target","8"],["i","1"]]]],"o":"","n":"2번 줄 실행 → i: 0 → 1"},{"l":2,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]],["linear_search()",[["arr","[9, 5, 8, 3, 7]"],["target","8"],["i","1"]]]],"o":"","n":"3번 줄 실행 → 조건을 확인했어요."},{"l":3,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]],["linear_search()",[["arr","[9, 5, 8, 3, 7]"],["target","8"],["i","2"]]]],"o":"","n":"2번 줄 실행 → i: 1 → 2"},{"l":4,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]],["linear_search()",[["arr","[9, 5, 8, 3, 7]"],["target","8"],["i","2"]]]],"o":"","n":"3번 줄 실행 → 조건을 확인했어요."},{"l":4,"k":"ret","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"]]],["linear_search()",[["arr","[9, 5, 8, 3, 7]"],["target","8"],["i","2"]]]],"o":"","r":"2"},{"l":10,"k":"line","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"],["result","2"]]]],"o":"","n":"linear_search()가 돌려준 2을(를) 받아 계속해요."},{"l":0,"k":"end","s":[["전역",[["linear_search","함수"],["arr","[9, 5, 8, 3, 7]"],["target","8"],["result","2"]]]],"o":"Target found at index: 2\n","n":"10번 줄 실행 → 화면에 출력: Target found at index: 2 프로그램이 끝났어요."}]}