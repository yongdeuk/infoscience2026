{"code":["class Robot:","    def __init__(self, name):     # 생성자 — 객체가 만들어질 때 실행","        self.name = name","        self.speed = 0","    def run(self):","        self.speed = 10","        print(f'{self.name}가 {self.speed}km/h로 달립니다.')","","robot1 = Robot('로봇A')","robot1.run()"],"notes":{},"steps":[{"l":1,"k":"line","s":[["전역",[]]],"o":"","n":"프로그램을 시작해요. 위에서부터 한 줄씩 실행해요."},{"l":1,"k":"line","s":[["전역",[]],["Robot()",[]]],"o":"","n":"1번 줄 실행 → Robot() 함수를 불렀어요."},{"l":2,"k":"line","s":[["전역",[]],["Robot()",[]]],"o":"","n":"1번 줄 실행 → 바뀐 값은 없어요."},{"l":5,"k":"line","s":[["전역",[]],["Robot()",[]]],"o":"","n":"2번 줄 실행 → 바뀐 값은 없어요."},{"l":5,"k":"ret","s":[["전역",[]],["Robot()",[["run","함수"]]]],"o":"","r":"None"},{"l":9,"k":"line","s":[["전역",[["Robot","클래스"]]]],"o":"","n":"Robot()가 돌려준 None을(를) 받아 계속해요."},{"l":3,"k":"line","s":[["전역",[["Robot","클래스"]]],["__init__()",[["self","Robot()"],["name","'로봇A'"]]]],"o":"","n":"9번 줄 실행 → __init__() 함수를 불렀어요 (self=Robot(), name='로봇A')."},{"l":4,"k":"line","s":[["전역",[["Robot","클래스"]]],["__init__()",[["self","Robot(name='로봇A')"],["name","'로봇A'"]]]],"o":"","n":"3번 줄 실행 → self: Robot() → Robot(name='로봇A')"},{"l":4,"k":"ret","s":[["전역",[["Robot","클래스"]]],["__init__()",[["self","Robot(name='로봇A', speed=0)"],["name","'로봇A'"]]]],"o":"","r":"None"},{"l":10,"k":"line","s":[["전역",[["Robot","클래스"],["robot1","Robot(name='로봇A', speed=0)"]]]],"o":"","n":"__init__()가 돌려준 None을(를) 받아 계속해요."},{"l":6,"k":"line","s":[["전역",[["Robot","클래스"],["robot1","Robot(name='로봇A', speed=0)"]]],["run()",[["self","Robot(name='로봇A', speed=0)"]]]],"o":"","n":"10번 줄 실행 → run() 함수를 불렀어요 (self=Robot(name='로봇A', speed=0))."},{"l":7,"k":"line","s":[["전역",[["Robot","클래스"],["robot1","Robot(name='로봇A', speed=10)"]]],["run()",[["self","Robot(name='로봇A', speed=10)"]]]],"o":"","n":"6번 줄 실행 → robot1: Robot(name='로봇A', speed=0) → Robot(name='로봇A', speed=10) self: Robot(name='로봇A', speed=0) → Robot(name='로봇A', speed=10)"},{"l":7,"k":"ret","s":[["전역",[["Robot","클래스"],["robot1","Robot(name='로봇A', speed=10)"]]],["run()",[["self","Robot(name='로봇A', speed=10)"]]]],"o":"로봇A가 10km/h로 달립니다.\n","r":"None"},{"l":0,"k":"end","s":[["전역",[["Robot","클래스"],["robot1","Robot(name='로봇A', speed=10)"]]],["run()",[["self","Robot(name='로봇A', speed=10)"]]]],"o":"로봇A가 10km/h로 달립니다.\n","n":"run()가 돌려준 None을(를) 받아 계속해요. 프로그램이 끝났어요."}]}