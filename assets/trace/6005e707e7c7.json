{"code":["# 삼각형 조건: 두 변의 길이 합이 나머지 한 변보다 길어야 한다.","perimeter = 9                          # 화단 둘레","count = 0","","a = 1                                  # a, b, c는 삼각형의 세 변 (a ≤ b ≤ c)","while a < (perimeter // 2):            # ❶ 한 변은 둘레의 절반 미만","    b = a","    while b <= (perimeter - a) // 2:   # ❷ b는 c보다 작거나 같게","        c = perimeter - a - b          # 둘레가 정해져 있으니 c는 저절로 정해짐","        if c < b:                      # 삼각형 성립 불가능한 경우 가지치기","            break","        if a + b > c and a + c > b and b + c > a:   # ❸ 삼각형 조건 검사","            count += 1","        b += 1","    a += 1","","print(f'만들 수 있는 화단의 수: {count}')"],"notes":{},"steps":[{"l":2,"k":"line","s":[["전역",[["b","9"],["c","9"]]]],"o":"","n":"프로그램을 시작해요. 위에서부터 한 줄씩 실행해요."},{"l":3,"k":"line","s":[["전역",[["b","9"],["c","9"],["perimeter","9"]]]],"o":"","n":"2번 줄 실행 → perimeter에 9이(가) 저장됐어요."},{"l":5,"k":"line","s":[["전역",[["b","9"],["c","9"],["perimeter","9"],["count","0"]]]],"o":"","n":"3번 줄 실행 → count에 0이(가) 저장됐어요."},{"l":6,"k":"line","s":[["전역",[["b","9"],["c","9"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"5번 줄 실행 → a에 1이(가) 저장됐어요."},{"l":7,"k":"line","s":[["전역",[["b","9"],["c","9"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"6번 줄 실행 → 조건을 확인했어요."},{"l":8,"k":"line","s":[["전역",[["b","1"],["c","9"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"7번 줄 실행 → b: 9 → 1"},{"l":9,"k":"line","s":[["전역",[["b","1"],["c","9"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"8번 줄 실행 → 조건을 확인했어요."},{"l":10,"k":"line","s":[["전역",[["b","1"],["c","7"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"9번 줄 실행 → c: 9 → 7"},{"l":12,"k":"line","s":[["전역",[["b","1"],["c","7"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"10번 줄 실행 → 조건을 확인했어요."},{"l":14,"k":"line","s":[["전역",[["b","1"],["c","7"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"12번 줄 실행 → 조건을 확인했어요."},{"l":8,"k":"line","s":[["전역",[["b","2"],["c","7"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"14번 줄 실행 → b: 1 → 2"},{"l":9,"k":"line","s":[["전역",[["b","2"],["c","7"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"8번 줄 실행 → 조건을 확인했어요."},{"l":10,"k":"line","s":[["전역",[["b","2"],["c","6"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"9번 줄 실행 → c: 7 → 6"},{"l":12,"k":"line","s":[["전역",[["b","2"],["c","6"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"10번 줄 실행 → 조건을 확인했어요."},{"l":14,"k":"line","s":[["전역",[["b","2"],["c","6"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"12번 줄 실행 → 조건을 확인했어요."},{"l":8,"k":"line","s":[["전역",[["b","3"],["c","6"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"14번 줄 실행 → b: 2 → 3"},{"l":9,"k":"line","s":[["전역",[["b","3"],["c","6"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"8번 줄 실행 → 조건을 확인했어요."},{"l":10,"k":"line","s":[["전역",[["b","3"],["c","5"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"9번 줄 실행 → c: 6 → 5"},{"l":12,"k":"line","s":[["전역",[["b","3"],["c","5"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"10번 줄 실행 → 조건을 확인했어요."},{"l":14,"k":"line","s":[["전역",[["b","3"],["c","5"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"12번 줄 실행 → 조건을 확인했어요."},{"l":8,"k":"line","s":[["전역",[["b","4"],["c","5"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"14번 줄 실행 → b: 3 → 4"},{"l":9,"k":"line","s":[["전역",[["b","4"],["c","5"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"8번 줄 실행 → 조건을 확인했어요."},{"l":10,"k":"line","s":[["전역",[["b","4"],["c","4"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"9번 줄 실행 → c: 5 → 4"},{"l":12,"k":"line","s":[["전역",[["b","4"],["c","4"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"10번 줄 실행 → 조건을 확인했어요."},{"l":13,"k":"line","s":[["전역",[["b","4"],["c","4"],["perimeter","9"],["count","0"],["a","1"]]]],"o":"","n":"12번 줄 실행 → 조건을 확인했어요."},{"l":14,"k":"line","s":[["전역",[["b","4"],["c","4"],["perimeter","9"],["count","1"],["a","1"]]]],"o":"","n":"13번 줄 실행 → count: 0 → 1"},{