{"code":["def f(n):","    if n == 1:","        return 1            # f(1) = 1","    else:","        return 0            # 이 줄을 관계식에 맞게 고쳐 보자","","print(f(5))                 # 120 이 나오면 성공"],"notes":{},"steps":[{"l":1,"k":"line","s":[["전역",[]]],"o":"","n":"프로그램을 시작해요. 위에서부터 한 줄씩 실행해요."},{"l":7,"k":"line","s":[["전역",[["f","함수"]]]],"o":"","n":"1번 줄 실행 → f 함수를 정의했어요(아직 실행되지는 않아요)."},{"l":2,"k":"line","s":[["전역",[["f","함수"]]],["f()",[["n","5"]]]],"o":"","n":"7번 줄 실행 → f() 함수를 불렀어요 (n=5)."},{"l":5,"k":"line","s":[["전역",[["f","함수"]]],["f()",[["n","5"]]]],"o":"","n":"2번 줄 실행 → 조건을 확인했어요."},{"l":5,"k":"ret","s":[["전역",[["f","함수"]]],["f()",[["n","5"]]]],"o":"","r":"0"},{"l":0,"k":"end","s":[["전역",[["f","함수"]]],["f()",[["n","5"]]]],"o":"0\n","n":"f()가 돌려준 0을(를) 받아 계속해요. 화면에 출력: 0 프로그램이 끝났어요."}]}