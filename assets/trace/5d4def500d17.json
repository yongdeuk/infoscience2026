{"code":["def quicksort(arr):                            # 퀵 정렬 함수","    if len(arr) <= 1:                          # 길이가 1 이하이면 정렬할 필요 없음(종료 조건)","        return arr","    pivot = arr[0]                             # 가장 왼쪽 값을 피벗으로","    left  = [x for x in arr[1:] if x <= pivot] # 피벗과 같거나 작은 값","    right = [x for x in arr[1:] if x >  pivot] # 피벗보다 큰 값","    return quicksort(left) + [pivot] + quicksort(right)   # 각각 정렬해 이어 붙임","","input_list = [7, 5, 9, 4, 1]                   # 정렬 전 리스트","print(quicksort(input_list))"],"notes":{},"steps":[{"l":1,"k":"line","s":[["전역",[]]],"o":"","n":"프로그램을 시작해요. 위에서부터 한 줄씩 실행해요."},{"l":9,"k":"line","s":[["전역",[["quicksort","함수"]]]],"o":"","n":"1번 줄 실행 → quicksort 함수를 정의했어요(아직 실행되지는 않아요)."},{"l":10,"k":"line","s":[["전역",[["quicksort","함수"],["input_list","[7, 5, 9, 4, 1]"]]]],"o":"","n":"9번 줄 실행 → input_list에 [7, 5, 9, 4, 1]이(가) 저장됐어요."},{"l":2,"k":"line","s":[["전역",[["quicksort","함수"],["input_list","[7, 5, 9, 4, 1]"]]],["quicksort()",[["arr","[7, 5, 9, 4, 1]"]]]],"o":"","n":"10번 줄 실행 → quicksort() 함수를 불렀어요 (arr=[7, 5, 9, 4, 1])."},{"l":4,"k":"line","s":[["전역",[["quicksort","함수"],["input_list","[7, 5, 9, 4, 1]"]]],["quicksort()",[["arr","[7, 5, 9, 4, 1]"]]]],"o":"","n":"2번 줄 실행 → 조건을 확인했어요."},{"l":5,"k":"line","s":[["전역",[["quicksort","함수"],["input_list","[7, 5, 9, 4, 1]"]]],["quicksort()",[["arr","[7, 5, 9, 4, 1]"],["pivot","7"]]]],"o":"","n":"4번 줄 실행 → pivot에 7이(가) 저장됐어요."},{"l":6,"k":"line","s":[["전역",[["quicksort","함수"],["input_list","[7, 5, 9, 4, 1]"]]],["quicksort()",[["arr","[7, 5, 9, 4, 1]"],["pivot","7"],["left","[5, 4, 1]"]]]],"o":"","n":"5번 줄 실행 → left에 [5, 4, 1]이(가) 저장됐어요."},{"l":7,"k":"line","s":[["전역",[["quicksort","함수"],["input_list","[7, 5, 9, 4, 1]"]]],["quicksort()",[["arr","[7, 5, 9, 4, 1]"],["pivot","7"],["left","[5, 4, 1]"],["right","[9]"]]]],"o":"","n":"6번 줄 실행 → right에 [9]이(가) 저장됐어요."},{"l":2,"k":"line","s":[["전역",[["quicksort","함수"],["input_list","[7, 5, 9, 4, 1]"]]],["quicksort()",[["arr","[7, 5, 9, 4, 1]"],