{"code":["n, k = 17, 4","count = 0","while n > 1:","    if n % k == 0:        # 나누어떨어지면 나누기 (가장 좋아 보이는 선택)","        n //= k","    else:                 # 아니면 1 빼기","        n -= 1","    count += 1","print('최소 횟수:', count)"],"notes":{},"steps":[{"l":1,"k":"line","s":[["전역",[]]],"o":"","n":"프로그램을 시작해요. 위에서부터 한 줄씩 실행해요."},{"l":2,"k":"line","s":[["전역",[["n","17"],["k","4"]]]],"o":"","n":"1번 줄 실행 → n에 17이(가) 저장됐어요. k에 4이(가) 저장됐어요."},{"l":3,"k":"line","s":[["전역",[["n","17"],["k","4"],["count","0"]]]],"o":"","n":"2번 줄 실행 → count에 0이(가) 저장됐어요."},{"l":4,"k":"line","s":[["전역",[["n","17"],["k","4"],["count","0"]]]],"o":"","n":"3번 줄 실행 → 조건을 확인했어요."},{"l":7,"k":"line","s":[["전역",[["n","17"],["k","4"],["count","0"]]]],"o":"","n":"4번 줄 실행 → 조건을 확인했어요."},{"l":8,"k":"line","s":[["전역",[["n","16"],["k","4"],["count","0"]]]],"o":"","n":"7번 줄 실행 → n: 17 → 16"},{"l":3,"k":"line","s":[["전역",[["n","16"],["k","4"],["count","1"]]]],"o":"","n":"8번 줄 실행 → count: 0 → 1"},{"l":4,"k":"line","s":[["전역",[["n","16"],["k","4"],["count","1"]]]],"o":"","n":"3번 줄 실행 → 조건을 확인했어요."},{"l":5,"k":"line","s":[["전역",[["n","16"],["k","4"],["count","1"]]]],"o":"","n":"4번 줄 실행 → 조건을 확인했어요."},{"l":8,"k":"line","s":[["전역",[["n","4"],["k","4"],["count","1"]]]],"o":"","n":"5번 줄 실행 → n: 16 → 4"},{"l":3,"k":"line","s":[["전역",[["n","4"],["k","4"],["count","2"]]]],"o":"","n":"8번 줄 실행 → count: 1 → 2"},{"l":4,"k":"line","s":[["전역",[["n","4"],["k","4"],["count","2"]]]],"o":"","n":"3번 줄 실행 → 조건을 확인했어요."},{"l":5,"k":"line","s":[["전역",[["n","4"],["k","4"],["count","2"]]]],"o":"","n":"4번 줄 실행 → 조건을 확인했어요."},{"l":8,"k":"line","s":[["전역",[["n","1"],["k","4"],["count","2"]]]],"o":"","n":"5번 줄 실행 → n: 4 → 1"},{"l":3,"k":"line","s":[["전역",[["n","1"],["k","4"],["count","3"]]]],"o":"","n":"8번 줄 실행 → count: 2 → 3"},{"l":9,"k":"line","s":[["전역",[["n","1"],["k","4"],["count","3"]]]],"o":"","n":"3번 줄 실행 → 조건을 확인했어요."},{"l":0,"k":"end","s":[["전역",[["n","1"],["k","4"],["count","3"]]]],"o":"최소 횟수: 3\n","n":"9번 줄 실행 → 화면에 출력: 최소 횟수: 3 프로그램이